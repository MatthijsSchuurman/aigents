#!/bin/bash

workdir=$(pwd)
aigentdir=$(dirname $0)
platform=$(basename $0)

bubblewrap_cmd="bwrap
 --ro-bind /usr /usr
 --ro-bind /lib /lib
 --ro-bind /lib64 /lib64
 --ro-bind /etc/resolv.conf /etc/resolv.conf
 --ro-bind /etc/ssl /etc/ssl
 --ro-bind /etc/ca-certificates /etc/ca-certificates
 --symlink usr/bin /bin
 --proc /proc
 --dev /dev
 --tmpfs /tmp
 --die-with-parent
 --new-session
 --cap-drop ALL
 --unshare-all
 --share-net
 --bind $aigentdir/home /home/aigent
 --bind $workdir /home/aigent/workdir
 --chdir /home/aigent/workdir
 --clearenv
 --setenv HOME /home/aigent \
 --setenv USER aigent \
 --setenv PATH /bin:/usr/bin:/usr/local/bin:/home/aigent/.npm-global/bin:/home/aigent/go/bin \
"

case $1 in
  "build" | "rebuild")
    $bubblewrap_cmd mkdir -p /home/aigent/.npm-global
    $bubblewrap_cmd npm config set prefix /home/aigent/.npm-global

    case $platform in
      "agy")
        $bubblewrap_cmd curl -fsSL https://antigravity.google/cli/install.sh | bash
      ;;
      "claude")
        $bubblewrap_cmd npm install --global @anthropic-ai/claude-code@latest
      ;;
      "codex")
        $bubblewrap_cmd npm install --global @openai/codex@latest
      ;;
      "gemini")
        $bubblewrap_cmd npm install --global @google/gemini-cli@latest
      ;;
      "opencode")
        $bubblewrap_cmd npm install --global --allow-scripts=@opencode/cli @opencode/cli
      ;;
      "pi")
        $bubblewrap_cmd npm install --global --ignore-scripts @earendil-works/pi-coding-agent@latest
      ;;
    esac

    exit $?
  ;;
  "shell")
    shift
    $bubblewrap_cmd /bin/bash
    exit $?
  ;;
  *)
    $bubblewrap_cmd $platform "$@"
    exit $?
  ;;
esac
